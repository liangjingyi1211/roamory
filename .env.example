GOOGLE_API_KEY=your_google_ai_studio_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
ADK_MODEL=gemini-3.5-flash-lite
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
# Separate browser key: enable Maps JavaScript API, restrict by HTTP Referer.
# Allow http://localhost:8501/* and http://127.0.0.1:8501/* for local use.
# Do not reuse the server key above.
GOOGLE_MAPS_BROWSER_API_KEY=
# Optional local persistence location:
# ROAMORY_DB=data/roamory.sqlite3
# ROAMORY_LOG_FILE=data/backend.log
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash